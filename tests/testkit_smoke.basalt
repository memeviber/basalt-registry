include "../packages/testkit/0.1.0/src/testkit.basalt"

func main(): int {
  let failures: int = 0;
  if testkit::check_int(2 + 2, 4) == 0 then failures += 1;
  if testkit::check_bool(true, true) == 0 then failures += 1;
  if testkit::check_char('b', 'b') == 0 then failures += 1;
  if testkit::check_string("basalt", "basalt") == 0 then failures += 1;
  if testkit::check_between(7, 1, 10) == 0 then failures += 1;
  if testkit::check_not_int(7, 8) == 0 then failures += 1;
  if testkit::check_int(2 + 2, 5) != 0 then failures += 1;
  if testkit::check_string("left", "right") != 0 then failures += 1;
  return failures;
}
